 export const SDK_CONTRACT_VERSION = "1.1.0";
 
+type ActiveChatWriter = (data: string) => boolean;
+
+let _activeChatWriter: { id: symbol; write: ActiveChatWriter } | undefined;
+
+export function registerActiveChatWriter(writer: ActiveChatWriter): () => void {
+  const registration = { id: Symbol("active-chat-writer"), write: writer };
+  _activeChatWriter = registration;
+
+  return () => {
+    if (_activeChatWriter?.id === registration.id) _activeChatWriter = undefined;
+  };
+}
+
+export function sendToActiveChat(text: string): boolean {
+  if (typeof text !== "string" || !text.trim() || /[\r\n]/.test(text)) return false;
+  return _activeChatWriter?.write(`${text}\r`) ?? false;
+}
